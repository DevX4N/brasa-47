---
import { site } from '../data/site';
import { photos, img, srcset } from '../data/images';
import '../styles/tokens.css';
import '../styles/base.css';

const ogImage = img(photos.hero, 1200, 1200 / 630);
const title = `${site.name} — ${site.signature}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: site.description,
  url: site.url,
  image: ogImage,
  servesCuisine: ['Steakhouse', 'Churrasco contemporâneo'],
  priceRange: '$$$',
  telephone: site.phoneHref,
  acceptsReservations: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '18:30',
    closes: '00:00',
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url} />
    <meta name="theme-color" content="#090909" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={photos.hero.alt} />
    <meta property="og:locale" content="pt_BR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    {/* Larguras idênticas às do <img> do herói — qualquer diferença
        faz o browser baixar a foto duas vezes. */}
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      imagesrcset={srcset(photos.hero, [900, 1400, 2000, 2600])}
      imagesizes="100vw"
      href={img(photos.hero, 1400)}
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <!--
      DIRECTION CONTRACT — BRASA 47
      THESIS: A grelha é a estrutura, não o assunto. Recusa o arranjo padrão da
      categoria: herói centralizado com foto de bife, grade de cards de cortes, dourado.
      OWN-WORLD: Carvão #090909, ferro #11100E, brasa #C96A36. Barras de ferro
      full-bleed — aresta acesa, corpo, sombra por baixo — são a única divisória.
      Bodoni Moda contra Manrope; micro-caps estampadas; numerais tabulares.
      Zero cards, raio 2px, nenhuma sombra de SaaS. O cobre nunca é uniforme:
      acende onde o olho está e esfria até o quase-preto no repouso.
      STORY: O visitante entende que o fogo dita a casa, acredita porque vê o
      preparo e as medidas, e reserva uma das 47 mesas.
      FIRST VIEWPORT: Foto de chamas em tela cheia, escurecida. "Fogo. / Carne. /
      Experiência." em Bodoni, à esquerda, fora do centro. Barra de ferro corta a
      base; sobre ela, horário, cidade e o CTA de reserva.
      FORM: A Grelha — candidato 6 da lista própria; seed 481e4c73.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
