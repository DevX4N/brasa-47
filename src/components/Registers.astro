---
import Grate from './Grate.astro';
import { registers } from '../data/site';
---

<section class="reg" aria-label="A casa em números">
  <div class="shell">
    <ul class="reg__row">
      {registers.map((r, i) => (
        <li class="reg__item" data-rise style={`--rise-delay:${i * 90}ms`}>
          <p class="reg__figure display">
            <span class="tnum">{r.figure}</span><span class="reg__unit">{r.unit}</span>
          </p>
          <p class="reg__label">{r.label}</p>
          <p class="reg__note stamp">{r.note}</p>
        </li>
      ))}
    </ul>
  </div>
  <div class="shell">
    <Grate hot="72%" />
  </div>
</section>

<style>
  .reg {
    padding-bottom: clamp(var(--s-7), 4vw, var(--s-9));
  }

  .reg__row {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .reg__item {
    position: relative;
    padding-block: var(--s-6);
  }

  /* A divisória é a mesma barra da grelha — deitada aqui, de pé no tablet
     e no desktop. Aresta acesa, corpo, sombra por baixo: matéria, não
     hairline. Se virar `1px solid`, a seção vira tabela. */
  .reg__item::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--grate-h);
  }

  .reg__item:first-child::before {
    display: none;
  }

  /* Quatro números do mesmo tamanho em quatro colunas iguais são uma
     stats bar. Aqui cada registro tem o peso do que mede, e o conteúdo
     desce em degrau — as barras de ferro continuam alinhadas. */
  .reg__figure {
    font-family: var(--display);
    font-size: calc(clamp(3.2rem, 11vw, 4.6rem) * var(--fig, 1));
    line-height: 0.86;
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--bone);
  }

  .reg__unit {
    font-family: var(--sans);
    font-size: 0.26em;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--ember);
    margin-left: 0.22em;
    vertical-align: 0.9em;
  }

  .reg__label {
    margin-top: var(--s-4);
    font-size: 0.9375rem;
    color: var(--bone);
    line-height: 1.35;
  }

  .reg__note {
    margin-top: var(--s-2);
    color: var(--ash-dim);
    line-height: 1.6;
    letter-spacing: 0.14em;
  }

  @media (min-width: 620px) {
    .reg__row {
      grid-template-columns: 1fr 1fr;
    }

    .reg__item {
      padding-inline: var(--s-6);
    }

    .reg__item:nth-child(-n + 2)::before {
      display: none;
    }

    .reg__item:nth-child(odd) {
      padding-left: 0;
    }

    .reg__item:nth-child(even) {
      padding-right: 0;
    }

    .reg__item:nth-child(odd)::after {
      content: '';
      position: absolute;
      inset: 0 0 0 auto;
      width: 3px;
      background: var(--grate-v);
    }
  }

  @media (min-width: 1024px) {
    /* Larguras desiguais: "900°C" e "28 dias" pesam mais que "47". */
    .reg__row {
      grid-template-columns: 1.05fr 1.15fr 1.2fr 0.9fr;
    }

    .reg__item:nth-child(1) {
      --fig: 0.84;
      padding-top: var(--s-6);
    }

    .reg__item:nth-child(2) {
      --fig: 1.14;
    }

    .reg__item:nth-child(3) {
      --fig: 0.92;
      padding-top: var(--s-5);
    }

    /* 47 é o nome da casa: é ele que fecha a linha, em cima e maior. */
    .reg__item:nth-child(4) {
      --fig: 1.34;
    }

    .reg__item,
    .reg__item:nth-child(odd),
    .reg__item:nth-child(even) {
      padding-block: 0 var(--s-8);
      padding-inline: clamp(var(--s-5), 2.6vw, var(--s-8));
    }

    .reg__item::before {
      display: none;
    }

    .reg__item::after,
    .reg__item:nth-child(odd)::after {
      content: '';
      position: absolute;
      inset: 0 0 0 auto;
      width: 3px;
      background: var(--grate-v);
    }

    .reg__item:first-child {
      padding-left: 0;
    }

    .reg__item:last-child {
      padding-right: 0;
    }

    .reg__item:last-child::after {
      display: none;
    }

    .reg__note {
      margin-top: var(--s-3);
    }
  }
</style>
