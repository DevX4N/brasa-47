---
import Grate from './Grate.astro';
import { site, times } from '../data/site';
import { photos, img, srcset } from '../data/images';

const p = photos.reserva;
const parties = ['1', '2', '3', '4', '5', '6', '7', '8', 'Mais de 8'];
const occasions = ['Jantar', 'Aniversário', 'Jantar de negócios', 'Comemoração'];
---

<section class="res" id="reservar" aria-labelledby="res-t">
  <div class="res__bg" aria-hidden="true">
    <img
      src={img(p, 1600)}
      srcset={srcset(p, [900, 1600, 2200])}
      sizes="100vw"
      alt=""
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="shell res__grid">
    <div class="res__claim">
      <h2 class="res__title display" id="res-t" data-rise>
        Sua mesa<br />está esperando.
      </h2>
      <p class="res__lead lead" data-rise style="--rise-delay:110ms">
        Reserve sua experiência no Brasa 47. São
        <strong class="tnum">{site.seats} lugares</strong> — vale marcar com
        alguns dias de antecedência.
      </p>

      <dl class="res__info" data-rise style="--rise-delay:180ms">
        <div>
          <dt class="stamp">Funcionamento</dt>
          <dd>
            {site.hours.days}<br />
            <span class="tnum">{site.hours.time}</span>
          </dd>
        </div>
        <div>
          <dt class="stamp">Endereço</dt>
          <dd>
            {site.address.street}<br />
            {site.address.district} · {site.address.city} — {site.address.state}
          </dd>
        </div>
        <div>
          <dt class="stamp">Telefone</dt>
          <dd>
            <a class="res__tel tnum" href={`tel:${site.phoneHref}`}>{site.phone}</a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="res__panel" data-rise style="--rise-delay:140ms">
      <Grate hot="12%" heat={0.5} />

      <form class="form" data-form novalidate>
        <p class="form__head stamp">Pedido de reserva</p>

        <div class="field">
          <label for="f-nome">Nome</label>
          <input id="f-nome" name="nome" type="text" autocomplete="name" required
            aria-describedby="e-nome" />
          <p class="err" id="e-nome" data-err hidden></p>
        </div>

        <div class="field">
          <label for="f-tel">Telefone</label>
          <input id="f-tel" name="telefone" type="tel" inputmode="tel"
            autocomplete="tel" placeholder="(41) 99999-9999" required
            aria-describedby="e-tel" />
          <p class="err" id="e-tel" data-err hidden></p>
        </div>

        <div class="field field--wide">
          <label for="f-email">E-mail <span class="field__opt">opcional</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email"
            aria-describedby="e-email" />
          <p class="err" id="e-email" data-err hidden></p>
        </div>

        <div class="field">
          <label for="f-data">Data</label>
          <input id="f-data" name="data" type="date" required aria-describedby="e-data" />
          <p class="err" id="e-data" data-err hidden></p>
        </div>

        <div class="field">
          <label for="f-hora">Horário</label>
          <div class="sel">
            <select id="f-hora" name="hora" required aria-describedby="e-hora">
              <option value="">Escolher</option>
              {times.map((t) => <option value={t}>{t}</option>)}
            </select>
            <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
              <path d="M1 1l4.5 4.5L10 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
            </svg>
          </div>
          <p class="err" id="e-hora" data-err hidden></p>
        </div>

        <div class="field">
          <label for="f-pessoas">Pessoas</label>
          <div class="sel">
            <select id="f-pessoas" name="pessoas" required aria-describedby="e-pessoas">
              <option value="">Escolher</option>
              {parties.map((n) => <option value={n}>{n}</option>)}
            </select>
            <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
              <path d="M1 1l4.5 4.5L10 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
            </svg>
          </div>
          <p class="err" id="e-pessoas" data-err hidden></p>
        </div>

        <div class="field">
          <label for="f-ocasiao">Ocasião <span class="field__opt">opcional</span></label>
          <div class="sel">
            <select id="f-ocasiao" name="ocasiao">
              {occasions.map((o) => <option value={o}>{o}</option>)}
            </select>
            <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
              <path d="M1 1l4.5 4.5L10 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
            </svg>
          </div>
        </div>

        <div class="field field--wide">
          <label for="f-obs">Alguma observação? <span class="field__opt">opcional</span></label>
          <textarea id="f-obs" name="observacao" rows="2"
            placeholder="Restrições alimentares, cadeira infantil, mesa perto da grelha…"></textarea>
        </div>

        <div class="form__foot">
          <button class="btn btn--solid btn--lg form__send" type="submit" data-submit>
            <span data-submit-label>Reservar mesa</span>
            <svg class="btn__arrow" width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
              <path d="M1 5h13M10.5 1 14.5 5l-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
            </svg>
          </button>
          <p class="form__fine">
            Confirmamos por telefone em até 2 horas dentro do horário de
            funcionamento.
          </p>
        </div>

        <p class="form__alert" role="alert" data-form-alert hidden></p>
      </form>

      <div class="done" data-done hidden>
        <p class="done__t display">Pedido anotado.</p>
        <p class="done__b" data-done-detail></p>
        <p class="done__demo stamp">
          Demonstração · este formulário não envia dados. Ligue para
          <a class="tnum" href={`tel:${site.phoneHref}`}>{site.phone}</a> para
          reservar de verdade.
        </p>
        <button class="btn" type="button" data-reset>Fazer outro pedido</button>
      </div>
    </div>
  </div>
</section>

<style>
  .res {
    position: relative;
    isolation: isolate;
    padding-block: var(--section);
    background: var(--iron);
  }

  .res__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .res__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.35) contrast(1.25) brightness(0.28);
  }

  .res__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 70% at 18% 20%, rgba(143, 61, 37, 0.3), transparent 62%),
      linear-gradient(180deg, var(--void) 0%, rgba(9, 9, 9, 0.78) 26%, rgba(9, 9, 9, 0.9) 100%);
  }

  .res__grid {
    display: grid;
    row-gap: clamp(var(--s-8), 7vw, var(--s-10));
    column-gap: clamp(var(--s-5), 2.4vw, var(--s-7));
  }

  /* Em 5 colunas o --t-xl quebrava "está esperando." e deixava "está"
     sozinha no meio. A escala menor mantém a quebra que o texto pede. */
  .res__title {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 400;
  }

  .res__lead {
    margin-top: var(--s-6);
    max-width: 36ch;
  }

  .res__info {
    margin-top: clamp(var(--s-7), 5vw, var(--s-9));
    display: grid;
    gap: var(--s-6);
  }

  .res__info dt {
    color: var(--ember);
    margin-bottom: var(--s-3);
  }

  .res__info dd {
    color: var(--bone);
    line-height: 1.7;
    font-size: 0.9375rem;
  }

  .res__tel {
    border-bottom: 1px solid var(--rule-lit);
    padding-bottom: 2px;
    transition: color var(--t-mid) var(--ease), border-color var(--t-mid) var(--ease);
  }

  .res__tel:hover,
  .res__tel:focus-visible {
    color: var(--ember-hot);
    border-color: var(--ember);
  }

  /* --- painel do formulário ----------------------------------- */

  /* Sem moldura: o painel é limitado pela barra de ferro em cima e pelo
     desfoque, que existe para os campos ficarem legíveis sobre a foto.
     Três hairlines em volta fariam da única seção com formulário o único
     card da página. */
  .res__panel {
    position: relative;
    background: rgba(9, 9, 9, 0.62);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    padding: clamp(var(--s-6), 4vw, var(--s-8));
  }

  .form[hidden] {
    display: none;
  }

  .form__head {
    color: var(--ash-dim);
    letter-spacing: 0.18em;
    margin-bottom: var(--s-2);
  }

  .field {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }

  .field label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--bone);
  }

  .field__opt {
    font-weight: 400;
    color: var(--ash-dim);
    letter-spacing: 0.1em;
    font-size: 0.6875rem;
    text-transform: uppercase;
    margin-left: var(--s-2);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: var(--s-3) var(--s-4);
    background: rgba(255, 255, 255, 0.032);
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--bone);
    font-size: 0.9375rem;
    transition: border-color var(--t-mid) var(--ease), background var(--t-mid) var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 74px;
    line-height: 1.55;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--rule-lit);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ember);
    background: rgba(201, 106, 54, 0.06);
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--ember-hot);
    outline-offset: 1px;
  }

  .field [aria-invalid='true'] {
    border-color: var(--ember-deep);
    background: rgba(143, 61, 37, 0.12);
  }

  /* O seletor nativo em dark, com a seta da casa. */
  .sel {
    position: relative;
    display: grid;
  }

  .sel select {
    appearance: none;
    padding-right: var(--s-8);
    cursor: pointer;
  }

  .sel select option {
    background: var(--iron);
    color: var(--bone);
  }

  .sel svg {
    position: absolute;
    right: var(--s-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--ember);
    pointer-events: none;
  }

  /* O calendário nativo do Chrome vem branco — aqui ele é da casa. */
  .field input[type='date']::-webkit-calendar-picker-indicator {
    filter: invert(1) sepia(1) saturate(4) hue-rotate(-18deg) brightness(0.9);
    cursor: pointer;
    opacity: 0.8;
  }

  .err {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ember-hot);
  }

  .err[hidden] {
    display: none;
  }

  .form__foot {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-3);
  }

  .form__send {
    justify-content: center;
    width: 100%;
  }

  .form__send[data-busy] {
    cursor: progress;
  }

  .form__fine {
    font-size: 0.8125rem;
    color: var(--ash-dim);
    line-height: 1.6;
  }

  .form__alert {
    font-size: 0.875rem;
    color: var(--ember-hot);
    border-left: 1px solid var(--ember);
    padding-left: var(--s-4);
    line-height: 1.55;
  }

  .form__alert[hidden] {
    display: none;
  }

  /* --- estado de sucesso --------------------------------------- */

  .done {
    padding: clamp(var(--s-8), 6vw, 104px) clamp(var(--s-6), 4vw, var(--s-8));
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .done[hidden] {
    display: none;
  }

  .done__t {
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 400;
    line-height: 1;
  }

  .done__b {
    color: var(--ash);
    line-height: 1.65;
    max-width: 38ch;
  }

  .done__b strong {
    color: var(--bone);
    font-weight: 600;
  }

  .done__demo {
    position: relative;
    color: var(--ash-dim);
    line-height: 1.9;
    letter-spacing: 0.12em;
    padding-top: var(--s-5);
    margin-top: var(--s-2);
  }

  .done__demo::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--grate-h);
  }

  .done__demo a {
    color: var(--ember);
    border-bottom: 1px solid var(--rule-lit);
  }

  @media (min-width: 560px) {
    .form {
      grid-template-columns: 1fr 1fr;
    }
    .field--wide,
    .form__head,
    .form__foot,
    .form__alert {
      grid-column: 1 / -1;
    }
    .form__foot {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--s-6);
    }
    .form__send {
      width: auto;
    }
    .form__fine {
      max-width: 34ch;
    }
  }

  @media (min-width: 1024px) {
    .res__grid {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }
    .res__claim {
      grid-column: 1 / span 5;
      position: sticky;
      top: clamp(var(--s-9), 14vh, 168px);
    }
    .res__panel {
      grid-column: 7 / span 6;
    }
    .res__info {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-7) var(--s-5);
    }
  }
</style>
