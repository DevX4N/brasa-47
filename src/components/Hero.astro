---
import { site } from '../data/site';
import { photos, img, srcset } from '../data/images';

const p = photos.hero;
---

<section class="hero" id="top" data-hero>
  <div class="hero__media" data-hero-media>
    <img
      src={img(p, 1600)}
      srcset={srcset(p, [900, 1400, 2000, 2600])}
      sizes="100vw"
      alt={p.alt}
      width="2000"
      height="1125"
      fetchpriority="high"
      decoding="sync"
      style={`object-position:${p.focus}`}
    />
    <div class="hero__wash" aria-hidden="true"></div>
  </div>

  <div class="hero__body shell">
    <h1 class="hero__title display">
      <span>Fogo.</span>
      <span>Carne.</span>
      <span>Experiência.</span>
    </h1>

    <p class="hero__lead lead">
      Uma cozinha guiada pelo fogo, por ingredientes excepcionais
      e pelo respeito ao tempo.
    </p>

    <div class="hero__acts">
      <a class="btn btn--solid btn--lg" href="#reservar">
        Reservar mesa
        <svg class="btn__arrow" width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
          <path d="M1 5h13M10.5 1 14.5 5l-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
        </svg>
      </a>
      <a class="btn btn--lg" href="#menu">Conhecer o menu</a>
    </div>
  </div>

  <div class="hero__foot">
    <div class="grate hero__grate" style="--hot:22%" aria-hidden="true"></div>
    <div class="hero__meta shell">
      <div class="hero__id">
        <p class="stamp stamp--ember">{site.signature}</p>
        <p class="stamp hero__hours">
          {site.hours.days}<br />
          <span class="tnum">{site.hours.time}</span>
        </p>
      </div>
      <p class="stamp hero__where">
        {site.address.city} — {site.address.state}
      </p>
      <a class="hero__scroll" href="#experiencia" aria-label="Ir para o conteúdo">
        <span class="stamp">Role</span>
        <span class="hero__track" aria-hidden="true"><i></i></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: -6% 0 0;
    z-index: -1;
    will-change: transform;
  }

  .hero__media img {
    width: 100%;
    height: 106%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.2) brightness(0.6);
  }

  /* A luz vem do fogo, à direita. O texto mora no lado frio. */
  .hero__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(9, 9, 9, 0.94) 0%, rgba(9, 9, 9, 0.66) 44%, rgba(9, 9, 9, 0.1) 100%),
      linear-gradient(180deg, rgba(9, 9, 9, 0.88) 0%, transparent 34%, rgba(9, 9, 9, 0.72) 100%);
  }

  .hero__body {
    align-self: end;
    padding-bottom: clamp(var(--s-8), 9vh, var(--s-10));
    padding-top: calc(var(--s-10) + var(--s-6));
    max-width: min(var(--maxw), 100%);
  }

  .hero__title {
    font-size: var(--t-hero);
    line-height: 0.88;
    letter-spacing: -0.035em;
    font-weight: 400;
  }

  .hero__title span {
    display: block;
  }

  /* Cada palavra sobe separada — o fogo não sobe de uma vez só. */
  :global(.js) .hero__title span {
    opacity: 0;
    transform: translateY(0.34em);
    transition: opacity 1s var(--ease), transform 1.05s var(--ease);
  }

  :global(.js) .hero__title span:nth-child(2) {
    transition-delay: 110ms;
  }
  :global(.js) .hero__title span:nth-child(3) {
    transition-delay: 220ms;
  }

  :global(.js) [data-hero-ready] .hero__title span {
    opacity: 1;
    transform: none;
  }

  .hero__lead {
    margin-top: clamp(var(--s-5), 3vh, var(--s-7));
    max-width: 34ch;
    color: var(--bone);
    opacity: 0.78;
  }

  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: clamp(var(--s-6), 4vh, var(--s-8));
  }

  /* No celular os dois CTAs ocupam a largura toda: botões de larguras
     diferentes empilhados à esquerda leem como desalinho, não composição. */
  @media (max-width: 559px) {
    .hero__acts {
      display: grid;
      grid-template-columns: 1fr;
    }

    .hero__acts .btn {
      justify-content: center;
    }
  }

  :global(.js) .hero__lead,
  :global(.js) .hero__acts {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 900ms var(--ease), transform 900ms var(--ease);
  }

  :global(.js) .hero__lead {
    transition-delay: 380ms;
  }
  :global(.js) .hero__acts {
    transition-delay: 470ms;
  }

  :global(.js) [data-hero-ready] .hero__lead,
  :global(.js) [data-hero-ready] .hero__acts {
    opacity: 1;
    transform: none;
  }

  :global(.js) [data-hero-ready] .hero__lead {
    opacity: 0.78;
  }

  /* A placa acende depois da barra: primeiro o ferro, depois o registro. */
  :global(.js) .hero__meta {
    opacity: 0;
    transition: opacity 900ms var(--ease) 760ms;
  }

  :global(.js) [data-hero-ready] .hero__meta {
    opacity: 1;
  }

  /* --- a barra que fecha o herói ------------------------------- */

  .hero__foot {
    align-self: end;
    padding-bottom: max(var(--s-5), env(safe-area-inset-bottom));
  }

  .hero__grate {
    --heat: 0.85;
  }

  :global(.js) .hero__grate {
    transform: scaleX(0);
    transition: transform 1.6s var(--ease) 620ms;
  }

  :global(.js) [data-hero-ready] .hero__grate {
    transform: scaleX(1);
  }

  .hero__meta {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--s-5);
    row-gap: var(--s-2);
    align-items: end;
    padding-top: var(--s-5);
  }

  /* A placa da casa fica estampada no ferro, sob a barra — assinatura da
     marca, não rótulo pendurado acima do título. */
  .hero__id {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: var(--s-2);
  }

  .hero__where {
    grid-column: 1;
    grid-row: 2;
    color: var(--ash-dim);
  }

  .hero__hours {
    color: var(--ash-dim);
  }

  /* No celular o indicador senta na última linha da placa: flutuando no
     meio de quatro registros ele lê como peça solta. */
  .hero__scroll {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
    display: flex;
    align-items: flex-end;
    gap: var(--s-3);
    color: var(--ash-dim);
    transition: color var(--t-mid) var(--ease);
  }

  .hero__scroll:hover,
  .hero__scroll:focus-visible {
    color: var(--ember);
  }

  .hero__track {
    display: block;
    position: relative;
    width: 1px;
    height: 22px;
    background: var(--rule);
    overflow: hidden;
  }

  .hero__track i {
    position: absolute;
    inset: 0 0 auto;
    height: 12px;
    background: var(--ember-hot);
    animation: drip 2.6s var(--ease-cool) infinite;
  }

  @keyframes drip {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(300%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__track i {
      animation: none;
      transform: translateY(60%);
    }
    :global(.js) .hero__title span,
    :global(.js) .hero__meta,
    :global(.js) .hero__lead,
    :global(.js) .hero__acts,
    :global(.js) .hero__grate {
      opacity: 1;
      transform: none;
      transition: none;
    }
    :global(.js) .hero__lead {
      opacity: 0.78;
    }
  }

  /* Entre 560 e 1024 o recorte da foto é o mais fechado de todas as
     larguras; com a lavagem do celular por cima ela sumia inteira. */
  @media (min-width: 560px) {
    .hero__wash {
      background:
        linear-gradient(90deg, rgba(9, 9, 9, 0.94) 0%, rgba(9, 9, 9, 0.62) 42%, rgba(9, 9, 9, 0.06) 88%),
        linear-gradient(180deg, rgba(9, 9, 9, 0.78) 0%, transparent 32%, rgba(9, 9, 9, 0.7) 100%);
    }
  }

  @media (min-width: 720px) {
    .hero__meta {
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
    }

    .hero__where {
      grid-column: 2;
      grid-row: 1;
      text-align: center;
    }

    .hero__scroll {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
      align-self: start;
      align-items: center;
    }

    .hero__track {
      height: 30px;
    }
  }

  @media (min-width: 1024px) {
    .hero__body {
      padding-bottom: clamp(var(--s-9), 12vh, 168px);
    }
    .hero__lead {
      max-width: 38ch;
    }
    .hero__wash {
      background:
        linear-gradient(90deg, rgba(9, 9, 9, 0.94) 0%, rgba(9, 9, 9, 0.6) 42%, rgba(9, 9, 9, 0.2) 82%),
        linear-gradient(180deg, rgba(9, 9, 9, 0.78) 0%, transparent 32%, rgba(9, 9, 9, 0.72) 100%);
    }
  }
</style>
