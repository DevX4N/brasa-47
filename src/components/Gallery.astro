---
import Figure from './Figure.astro';
import Grate from './Grate.astro';
import { galleryPhotos } from '../data/images';

/** Deslocamento vertical por item: a galeria nunca alinha numa linha só. */
const drift = [0, 1, 0, 1, 0, 1, 0, 0];
---

<section class="gal" id="galeria" aria-labelledby="gal-t">
  <div class="shell">
    <Grate hot="64%" />
    <h2 class="sr" id="gal-t">Galeria</h2>
    <p class="gal__intro display" data-rise>
      O que o fogo<br />deixa para trás.
    </p>
  </div>

  <div class="shell gal__grid">
    {galleryPhotos.map((p, i) => (
      <div
        class:list={['gal__cell', `gal__cell--${p.span}`, drift[i] && 'gal__cell--drift']}
        data-parallax={i % 3 === 1 ? '0.06' : undefined}
      >
        <Figure
          photo={p}
          sizes="(min-width: 1024px) 34vw, (min-width: 620px) 48vw, 92vw"
          widths={[380, 620, 900, 1300]}
          delay={(i % 3) * 90}
          lift
        />
      </div>
    ))}
  </div>
</section>

<style>
  .gal {
    padding-bottom: var(--section);
  }

  .gal__intro {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 400;
    padding-block: clamp(var(--s-7), 6vw, var(--s-9)) clamp(var(--s-7), 6vw, var(--s-9));
  }

  .gal__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(var(--s-3), 1.6vw, var(--s-5));
    align-items: start;
  }

  .gal__cell--wide {
    grid-column: span 2;
  }

  @media (min-width: 620px) {
    .gal__grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .gal__cell--wide {
      grid-column: span 4;
    }
    .gal__cell--tall {
      grid-column: span 2;
    }
    .gal__cell--square {
      grid-column: span 3;
    }
    .gal__cell--small {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    /* Composição explícita, não empacotamento automático: com spans
       soltos o grid deixa buracos de meia fileira. Cada foto tem o seu
       lugar, e as colunas que sobram são ar de propósito. */
    .gal__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: clamp(var(--s-4), 1.8vw, var(--s-6));
    }

    .gal__cell {
      grid-column: auto;
    }

    .gal__cell:nth-child(1) {
      grid-column: 1 / 8;
    }
    .gal__cell:nth-child(2) {
      grid-column: 9 / 13;
    }
    .gal__cell:nth-child(3) {
      grid-column: 2 / 6;
    }
    .gal__cell:nth-child(4) {
      grid-column: 7 / 11;
    }
    .gal__cell:nth-child(5) {
      grid-column: 1 / 9;
    }
    .gal__cell:nth-child(6) {
      grid-column: 10 / 13;
    }
    .gal__cell:nth-child(7) {
      grid-column: 3 / 7;
    }
    .gal__cell:nth-child(8) {
      grid-column: 8 / 13;
    }

    /* Alturas desiguais — a fileira respira em vez de marchar. */
    .gal__cell--drift {
      margin-top: clamp(var(--s-6), 3.5vw, var(--s-9));
    }

    .gal__cell[data-parallax] {
      will-change: transform;
    }
  }
</style>
